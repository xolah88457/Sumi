{
  "name": "trade-journal-monorepo",
  "version": "0.4.1",
  "private": true,
  "description": "Sumi: a local-first desktop trade journal. Broker sync, deep analytics, daily journaling, and optional AI reflection.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xolah88457/trade-journal.git"
  },
  "author": "Sumi contributors <noreply@github.com>",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "preview": "pnpm build && pnpm start",
    "tauri:build": "node desktop/tauri/run.mjs build",
    "tauri:open": "node desktop/tauri/run.mjs open",
    "tauri:check": "node --test desktop/tauri/run.test.mjs && node desktop/tauri/run.mjs check",
    "desktop:build": "pnpm tauri:build",
    "desktop:open": "pnpm tauri:open",
    "desktop:check": "pnpm tauri:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
